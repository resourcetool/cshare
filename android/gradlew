#!/bin/sh
# Minimal Gradle wrapper launcher. gradle/wrapper/gradle-wrapper.jar is a binary that must be
# generated once with:  gradle wrapper --gradle-version 8.10.2   (or by opening android/ in
# Android Studio). See README.md.
APP_HOME=$(cd "$(dirname "$0")" && pwd -P)
if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then JAVACMD="$JAVA_HOME/bin/java"; else JAVACMD=java; fi
exec "$JAVACMD" -Xmx64m -Xms64m -classpath "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" org.gradle.wrapper.GradleWrapperMain "$@"
